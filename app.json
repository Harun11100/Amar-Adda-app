{
  "expo": {
    "name": "Amar Adda",
    "slug": "amar-adda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amaradda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon2.png",
        "backgroundImage": "./assets/images/icon2.png",
        "monochromeImage": "./assets/images/icon2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mdharun.amaradda"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icon2.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "API_URL": "https://amar-adda-restaurant.vercel.app/",
      "router": {},
      "eas": {
        "projectId": "542013c8-f786-43c0-8ab0-c4961ae1960e"
      }
    }
  }
}
